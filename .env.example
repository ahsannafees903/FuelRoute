# ==============================================================================
# FuelRoute — Environment Configuration Template
# Copy this file to .env for local development or set these variables in production.
# NEVER commit real production secrets, passwords, or keys to version control.
# ==============================================================================

# Core Django Settings
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only-change-me-in-production-use-a-strong-secret-key-at-least-50-chars
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production Security & HTTPS Settings (Enable when deployed behind HTTPS/TLS)
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_SECURE_HSTS_SECONDS=0

# External Routing & Geocoding Endpoints
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=FuelRoute-Engine/1.0 (ops@fuelroute.internal)

# Abuse & Rate Limiting Controls
RATE_LIMIT_ENABLED=1
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
